# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# MongoDB Connection
# ============================================
# Local development
MONGODB_URI=mongodb://localhost:27017/project-tracker

# Production (use environment variable or MongoDB Atlas connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/project-tracker?retryWrites=true&w=majority

# ============================================
# JWT Secret - CRITICAL SECURITY REQUIREMENT
# ============================================
# ⚠️  DO NOT use the example below in production!
# Generate a secure random secret using ONE of these methods:
#
# Method 1 (Node.js):
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# Method 2 (OpenSSL):
#   openssl rand -hex 64
#
# Method 3 (Online):
#   https://generate-secret.vercel.app/64
#
# Requirements:
# - Minimum 32 characters (64+ recommended)
# - Use cryptographically secure random generator
# - Store securely, NEVER commit to version control
# - Rotate periodically (every 90 days recommended)

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ============================================
# Frontend URL (for CORS)
# ============================================
# Set this to your frontend URL in production
# Example: https://yourapp.com
# Use * for development only (not recommended for production)

FRONTEND_URL=http://localhost:5173

# ============================================
# File Upload Configuration
# ============================================
# Maximum file size in bytes (default: 50MB)
# MAX_FILE_SIZE=52428800

# Maximum number of files per upload
# MAX_FILES=10

# ============================================
# Rate Limiting (Optional Overrides)
# ============================================
# General API: requests per 15 minutes
# RATE_LIMIT_GENERAL=100

# Auth routes: requests per minute
# RATE_LIMIT_AUTH=5

# Registration: requests per minute
# RATE_LIMIT_REGISTER=3

# ============================================
# Email Configuration (Future Use)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password
# EMAIL_FROM=noreply@yourapp.com

